# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database ─────────────────────────────────────────────────────────────────
# Replace with your PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chikn_tndr?schema=public"

# ─── Auth ─────────────────────────────────────────────────────────────────────
# CHANGE THIS to a long random secret in production!
JWT_SECRET=supersecretkeythatshouldbereplacedinproduction
JWT_EXPIRES_IN=7d

# ─── Google Maps Platform ─────────────────────────────────────────────────────
# Enable: Places API (New), Maps JavaScript API, Places Photos API
# https://console.cloud.google.com/apis
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Session defaults ─────────────────────────────────────────────────────────
DEFAULT_SEARCH_RADIUS_METERS=2000
MAX_RESTAURANTS_PER_SESSION=20
